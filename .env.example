# Server Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated or * for development)
# In production, set to your Vercel frontend URL, e.g. https://your-project.vercel.app
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://downloader-frontend.vercel.app,*

# Binaries Path (leave empty if available in system PATH)
# Examples:
# YTDLP_PATH=yt-dlp
# FFMPEG_PATH=ffmpeg
# DENO_PATH=deno
YTDLP_PATH=
FFMPEG_PATH=
DENO_PATH=

# Temp directory for downloading and processing files
TEMP_DIR=./temp

# Maximum download duration in milliseconds (default: 10 minutes)
MAX_DOWNLOAD_TIME_MS=600000

# File cleanup interval in milliseconds (default: 15 minutes)
CLEANUP_INTERVAL_MS=900000

# File expiration in milliseconds (default: 30 minutes)
FILE_EXPIRATION_MS=1800000

# Optional cookies file for age-gated or rate-limited YouTube/Instagram requests
COOKIES_FILE=
