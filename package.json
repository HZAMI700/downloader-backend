{
  "name": "downloader-backend",
  "version": "1.0.0",
  "description": "Production-ready backend API for YouTube and Instagram video/audio downloader using yt-dlp, FFmpeg, and Deno",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "postinstall": "tsc || true",
    "prestart": "tsc || true",
    "start": "node dist/index.js",
    "test": "node dist/index.js --health-check"
  },
  "keywords": [
    "yt-dlp",
    "ffmpeg",
    "deno",
    "youtube-downloader",
    "instagram-downloader",
    "express",
    "api"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@ffmpeg-installer/ffmpeg": "^1.1.0",
    "@ffprobe-installer/ffprobe": "^2.1.2",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.13.10",
    "@types/uuid": "^10.0.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "helmet": "^8.0.0",
    "morgan": "^1.10.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
