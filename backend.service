[Unit]
Description=Video Downloader Backend API (yt-dlp + FFmpeg + Deno)
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/var/www/downloader-backend
ExecStart=/usr/bin/node /var/www/downloader-backend/dist/index.js
Restart=always
RestartSec=10
StandardOutput=syslog
StandardError=syslog
SyslogIdentifier=video-downloader-backend
Environment=NODE_ENV=production
Environment=PORT=5000
Environment=PATH=/usr/local/bin:/usr/bin:/bin

[Install]
WantedBy=multi-user.target
